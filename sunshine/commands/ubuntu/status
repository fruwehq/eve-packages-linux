#!/usr/bin/env sh
set -eu

# Variables in the command payload expand on the guest.
# shellcheck disable=SC2016
exec ./scripts/package-status-command sunshine 'if command -v sunshine >/dev/null 2>&1 || dpkg-query -W -f="${Status}" sunshine 2>/dev/null | grep -q "install ok installed"; then echo installed; else echo missing; fi'
